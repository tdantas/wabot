# --- Required ---
GEMINI_API_KEY=your_gemini_api_key
FOOTBALL_API_KEY=your_football_api_key

# --- Optional (defaults shown) ---
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
LIVE_DOMAIN=https://wabot.okivia.net
TZ=Europe/Lisbon
LOG_LEVEL=info
VERBOSE=false
MONITOR_INTERVAL=30000

# --- Admin ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_PHONE=351966139786

# --- Database ---
DATABASE_URL=postgres://wabot:wabot@timescaledb:5432/wabot
# For local dev without Docker:
# DATABASE_URL=postgres://wabot:wabot@localhost:5432/wabot

# --- Widget API ---
# WIDGET_API_KEY=your_secret_key  (for Scriptable/widget access)

# --- Advanced (usually not needed) ---
# AUTH_DIR=./auth_info
# JWT_SECRET=your_secret_here  (auto-generated if not set)
