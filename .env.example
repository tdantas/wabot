# --- Required ---
GEMINI_API_KEY=your_gemini_api_key
FOOTBALL_API_KEY=your_football_api_key

# --- Optional (defaults shown) ---
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
TZ=Europe/Lisbon
LOG_LEVEL=info
VERBOSE=false
MONITOR_INTERVAL=30000

