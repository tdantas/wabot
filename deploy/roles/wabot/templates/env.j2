# --- Required ---
GEMINI_API_KEY={{ wabot_gemini_api_key | default('CHANGE_ME') }}
FOOTBALL_API_KEY={{ wabot_football_api_key | default('CHANGE_ME') }}

# --- Optional ---
GEMINI_MODEL={{ wabot_gemini_model | default('gemini-2.5-flash') }}
PORT={{ wabot_port }}
TZ={{ wabot_tz | default('Europe/Lisbon') }}
LOG_LEVEL={{ wabot_log_level | default('info') }}
VERBOSE={{ wabot_verbose | default('false') }}
MONITOR_INTERVAL={{ wabot_monitor_interval | default('30000') }}
LIVE_DOMAIN=https://{{ wabot_domain }}
JWT_SECRET={{ wabot_jwt_secret | default(lookup('password', '/dev/null length=32 chars=ascii_letters,digits')) }}

# --- Database ---
DATABASE_URL=postgres://{{ wabot_db_user }}:{{ wabot_db_password }}@host.docker.internal:5432/{{ wabot_db_name }}

# --- Admin ---
ADMIN_EMAIL={{ wabot_admin_email | default('') }}
ADMIN_PASSWORD={{ wabot_admin_password | default('') }}

# --- Widget API ---
{% if wabot_widget_api_key is defined %}
WIDGET_API_KEY={{ wabot_widget_api_key }}
{% endif %}
